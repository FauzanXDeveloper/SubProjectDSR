.DS_Store

# Local database from the old PHP build. This file holds REAL data -
# named user accounts with bcrypt password hashes, and customer cases
# with full IC numbers, incomes and CCRIS credit records. The GitHub
# repo is public: never commit it.
storage/
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Scratch/unrelated files
node_modules/

# Standalone calculator: the real login list holds working passwords and
# the GitHub repo is public. Commit data/users.example.js instead.
calculator/data/users.js

# Per-session app snapshots taken before risky changes. They are local
# recovery copies, not source, and may embed the local users file.
backups/calculator_*.zip
